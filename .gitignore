tmp/
.agents/
.codex/
__pycache__/
*.py[cod]

# Local Python virtualenvs (see CLAUDE.md dev setup)
.venv/
venv/
.pytest_cache/


# Mutable protected local governance state; never commit or include in Release source fingerprints.
.runtime_governance_state/

# Local (per-environment) Core activation state. The approved Core Release under
# THOMAS_CORE/releases/ is shared; activation is a local runtime step (see CLAUDE.md),
# so the current pointer lives in .runtime_governance_state/ and these stay local.
THOMAS_CORE/activations/
THOMAS_CORE/approvals/
THOMAS_CORE/CURRENT_CORE_RELEASE.yaml

# R8 approved internal workspace — the only tree the agent may write into. Its contents
# are per-machine runtime output, never shared source, so a controlled write can never
# reach a commit.
workspace/

# pytest --basetemp target (CLAUDE.md workaround for the pytest-of-thomas PermissionError)
.pytest_tmp/

# Compose secrets/per-host overrides (docker-compose.yml reads it; never commit values)
.env

# Build/compose output logs (regenerated artifacts; never shared source)
*.log

# pytest --junitxml report, written by CI for scripts/check_test_skips.py and by anyone
# reproducing that check locally. A run artifact, not source.
junit.xml

# Claude Code worktrees: local, per-session working copies of this repo (never source).
.claude/worktrees/

# Claude Code per-session scratch space. It sat neither tracked nor ignored, which is the
# one combination that goes wrong quietly: empty, it looks settled in `git status`, and the
# first session to drop a file there hands it to the next `git add -A` in a shared tree.
.claude/scratch/
