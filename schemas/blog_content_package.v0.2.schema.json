{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blog_content_package.v0.2.schema.json",
  "title": "Blog Content Package v0.2",
  "description": "One draft blog post, ready for a human to publish. v0.2 separates what v0.1 merged: `selection_evidence` is the multi-keyword brief the target was CHOSEN from, `target_evidence` is the research run on the chosen `target_keyword` itself, and every number in it (volume, blog post count, trend) is bound to that one keyword or absent — never borrowed from another row. v0.1 rows stay valid against their own schema; this is a new version, not a reinterpretation of the old one. The runtime never publishes: `published_url` is written back by the operator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "created_at_utc",
    "target_keyword",
    "selection_evidence",
    "target_evidence",
    "lineage",
    "title_candidates",
    "body_paste",
    "body_blocks",
    "tags",
    "image_shots",
    "sources",
    "fact_checks",
    "quality",
    "publish_state"
  ],
  "if": {
    "properties": {
      "publish_state": {
        "const": "published"
      }
    },
    "required": [
      "publish_state"
    ]
  },
  "then": {
    "description": "A package cannot claim to be published without the URL — that URL is the only input the ranking tracker has, and a `published` state without one silently ends the feedback loop.",
    "required": [
      "published_url"
    ]
  },
  "properties": {
    "schema_version": {
      "const": "blog_content_package.v0.2"
    },
    "package_id": {
      "type": "string",
      "pattern": "^bcp_[0-9a-f]{20}$"
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "target_keyword": {
      "description": "The one keyword this post is written to rank for. Exactly one, deliberately: a draft targeting three keywords ranks for none, and the ranking tracker needs a single subject.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "selection_evidence": {
      "description": "How the target was chosen. Candidate rows are the SELECTION brief's; none of their numbers describe the target unless the target is one of them, and a reader must take target numbers from `target_evidence` only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rule",
        "selected_keyword",
        "as_of",
        "degraded",
        "candidates"
      ],
      "properties": {
        "mode": {
          "enum": [
            "rule",
            "operator_override"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "selected_keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seeds": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "degraded": {
          "type": "boolean"
        },
        "degraded_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "candidates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keyword",
              "monthly_total",
              "ad_competition",
              "low_volume",
              "excluded_because"
            ],
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "monthly_total": {
                "type": "integer",
                "minimum": 0
              },
              "ad_competition": {
                "description": "Naver Search Ad `compIdx` — ADVERTISER BID competition, not blog difficulty. Recorded for the operator; never a selection gate.",
                "enum": [
                  "높음",
                  "중간",
                  "낮음",
                  "unknown"
                ]
              },
              "low_volume": {
                "type": "boolean"
              },
              "blog_competing_posts": {
                "type": "integer",
                "minimum": 0
              },
              "excluded_because": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "queue_score": {
                "description": "The vault queue's score for this candidate (demand weighted by reach), when the seeds came from the queue.",
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "seed_source": {
          "description": "Where the seeds came from: the schedule's request (`request`) or the vault keyword pipeline's queue (`vault_queue`, with the queue's date, how many candidates it listed, and how many were skipped as already written).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "request",
                "vault_queue"
              ]
            },
            "as_of": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "candidates_read": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_written": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "target_evidence": {
      "description": "The research run on `target_keyword` itself (the content run's own brief). `status: missing` means that brief carried no row for the target — the numbers are then ABSENT, never another keyword's. Missing is not zero.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyword",
        "status",
        "as_of",
        "degraded"
      ],
      "properties": {
        "keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "measured",
            "missing"
          ]
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "degraded": {
          "type": "boolean"
        },
        "degraded_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "matched_keyword": {
          "description": "The row's keyword as the venue spelled it (Search Ad strips spaces), matched to the target by normalized equality.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "monthly_pc": {
          "type": "integer",
          "minimum": 0
        },
        "monthly_mobile": {
          "type": "integer",
          "minimum": 0
        },
        "monthly_total": {
          "type": "integer",
          "minimum": 0
        },
        "low_volume": {
          "type": "boolean"
        },
        "ad_competition": {
          "description": "Naver Search Ad `compIdx` — ADVERTISER BID competition, not blog difficulty. Recorded for the operator; never a selection gate.",
          "enum": [
            "높음",
            "중간",
            "낮음",
            "unknown"
          ]
        },
        "volume_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "blog_competing_posts": {
          "description": "Naver's count of blog documents matching the target — the target's alone, never a sum across keywords.",
          "type": "integer",
          "minimum": 0
        },
        "blog_competing_posts_query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trend_keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trend_points": {
          "description": "Relative search interest, normalised to the peak of the requested window. Comparable within this array only — never across packages.",
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "ratio"
            ],
            "properties": {
              "period": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "ratio": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "lineage": {
      "description": "The runtime traces this package came from. Real trace ids of governed runs, or null where that run did not happen (an operator override has no selection research; a draft that passed first time has no revision).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_research_trace_id",
        "target_research_trace_id",
        "content_trace_id",
        "revision_trace_id"
      ],
      "properties": {
        "selection_research_trace_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "target_research_trace_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "content_trace_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_trace_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "title_candidates": {
      "description": "Alternatives for the operator to choose from, not a ranking. Each should carry the target keyword near the front.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "body_paste": {
      "description": "The body exactly as it should be pasted into the Naver SmartEditor: plain text, paragraphs separated by newlines, NO markdown. SmartEditor has no HTML mode and does not interpret markdown, so '##' and '**' would land in the published post as literal characters. All formatting intent lives in `body_blocks` instead.",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "body_blocks": {
      "description": "What to do to the pasted text in the editor, addressed by paragraph index. The split between this and `body_paste` is the whole point of the two-file output.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_index",
          "action"
        ],
        "properties": {
          "paragraph_index": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "enum": [
              "heading",
              "quote",
              "divider",
              "bold",
              "image"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "tags": {
      "description": "Naver caps a post at 30 tags.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      }
    },
    "image_shots": {
      "description": "Screens for the operator to capture — not generated images. Posts about using an AI tool need the tool's actual screen; a generated illustration reduces trust and, repeated across posts, becomes a tell.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "after_paragraph",
          "what_to_capture"
        ],
        "properties": {
          "after_paragraph": {
            "type": "integer",
            "minimum": 0
          },
          "what_to_capture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "tool_name": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "sources": {
      "description": "The draft's cited sources that resolved to evidence the producing run actually had ([S#] search hits, [K#] keyword rows; mock fixtures excluded). A reference the run never saw is dropped, not kept on trust.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "title"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "pattern": "^\\[[SK][0-9]{1,3}\\]$"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "fact_checks": {
      "description": "Statements the operator must verify before publishing — prices, free-tier scope, usage limits, feature availability, policy, versions, dates, API availability. Flagging is not verifying: the runtime emits only `needs_manual_verification` (no resolvable source) or `source_cited` (a source this run had — a place to check, not a check). `verified` exists for a human's later record and requires the source and the time.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "why",
          "category",
          "verification_state",
          "source_ref",
          "verified_at"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "category": {
            "enum": [
              "model_flagged",
              "price",
              "free_tier",
              "usage_limit",
              "version",
              "date",
              "api",
              "policy",
              "availability"
            ]
          },
          "verification_state": {
            "enum": [
              "needs_manual_verification",
              "source_cited",
              "verified"
            ]
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\[[SK][0-9]{1,3}\\]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verification_state": {
                  "const": "needs_manual_verification"
                }
              }
            },
            "then": {
              "properties": {
                "source_ref": {
                  "type": "null"
                },
                "verified_at": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verification_state": {
                  "const": "source_cited"
                }
              }
            },
            "then": {
              "properties": {
                "source_ref": {
                  "type": "string"
                },
                "verified_at": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verification_state": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "source_ref": {
                  "type": "string"
                },
                "verified_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              }
            }
          }
        ]
      }
    },
    "quality": {
      "description": "The draft's measurement against the lane's standards and what the one automatic revision did. `needs_edit` is a state for a human, never a reason the package was withheld; neither state publishes anything.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standards_version",
        "draft_format",
        "quality_state",
        "critical_pass",
        "failures",
        "first_draft_failures",
        "revision_count",
        "measured"
      ],
      "properties": {
        "standards_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "draft_format": {
          "enum": [
            "structured",
            "legacy_markdown"
          ]
        },
        "quality_state": {
          "enum": [
            "ready_for_review",
            "needs_edit"
          ]
        },
        "critical_pass": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "first_draft_failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "revision_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "revision_outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "measured": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 20
        },
        "revision_detail": {
          "description": "When the one revision was blocked: the governed run's own block message (which provider failed and how), so the reason survives past the lane's outer code.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "brackets_inserted": {
          "description": "How many closing brackets the final draft's JSON was missing and had put back before it parsed (blog_draft.repair_brackets). Absent when none were needed; the draft's text is never changed.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "publish_state": {
      "description": "`draft` until the operator publishes and returns the URL. The runtime never sets this to `published` on its own — it has no way to observe a publish it did not perform.",
      "enum": [
        "draft",
        "published"
      ]
    },
    "published_url": {
      "type": "string",
      "pattern": "^https://blog\\.naver\\.com/.+",
      "maxLength": 500
    },
    "published_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
