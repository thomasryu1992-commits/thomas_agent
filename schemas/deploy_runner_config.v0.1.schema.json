{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deploy_runner_config.v0.1.schema.json",
  "title": "Option C deploy runner — a service's root-owned configuration (C3b). Read at start; any doubt refuses to start",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role",
    "install_sha",
    "environment",
    "fingerprint",
    "socket",
    "allowed_uids",
    "directory"
  ],
  "properties": {
    "schema": {
      "const": "thomas.deploy_runner_config.v1"
    },
    "role": {
      "enum": [
        "gate",
        "actor"
      ]
    },
    "install_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}\\Z"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "host_label",
        "profile"
      ],
      "properties": {
        "project": {
          "const": "thomas_agent"
        },
        "host_label": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}\\Z"
        },
        "profile": {
          "enum": [
            "production"
          ]
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "distributions_sha256"
      ],
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^3\\.[0-9]{1,2}\\.[0-9]{1,3}\\Z"
        },
        "distributions_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        }
      }
    },
    "socket": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
    },
    "allowed_uids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967294
      }
    },
    "directory": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_socket",
        "actor_deadline_s"
      ],
      "properties": {
        "actor_socket": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "actor_deadline_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trees_root",
        "docker_bin",
        "git_bin",
        "ssh_keygen_bin",
        "trust_anchor",
        "allowed_signers",
        "revoked_keys",
        "revoked_approvals",
        "trust_owner_uid",
        "principal",
        "store_id",
        "policy",
        "inspect_min_interval_s"
      ],
      "properties": {
        "trees_root": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "docker_bin": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "git_bin": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "ssh_keygen_bin": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "trust_anchor": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "allowed_signers": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "revoked_keys": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "revoked_approvals": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._/-]{0,255}\\Z"
        },
        "trust_owner_uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967294
        },
        "principal": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._@-]{1,64}\\Z"
        },
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}\\Z"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_lifetime_s",
            "issue_skew_s",
            "clock_jump_s",
            "backstep_tolerance_s",
            "deadlines_s"
          ],
          "properties": {
            "max_lifetime_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "issue_skew_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "clock_jump_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "backstep_tolerance_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "deadlines_s": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "prepare_candidate",
                "validate_candidate",
                "promote",
                "rollback"
              ],
              "properties": {
                "prepare_candidate": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "validate_candidate": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "promote": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "rollback": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                }
              }
            }
          }
        },
        "inspect_min_interval_s": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3600
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "gate"
          }
        }
      },
      "then": {
        "required": [
          "gate"
        ],
        "not": {
          "required": [
            "actor"
          ]
        }
      },
      "else": {
        "required": [
          "actor"
        ],
        "not": {
          "required": [
            "gate"
          ]
        }
      }
    }
  ]
}
