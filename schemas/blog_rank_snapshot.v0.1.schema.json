{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blog_rank_snapshot.v0.1.schema.json",
  "title": "Blog Rank Snapshot v0.1",
  "description": "One observation of where a PUBLISHED blog content package ranks for its own target keyword. Append-only: a checkpoint is recorded once and never rewritten. `rank_position` is null when the post was not among the `result_window` results, or when the lookup failed (`degraded`); the two are told apart by `degraded`. The ordering is the blog search API's relevance order (`sort=sim`), a proxy for the blog tab, and `source` says so. A record, not feedback: nothing reads these into keyword selection on the strength of one observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "package_id",
    "target_keyword",
    "published_url",
    "checkpoint",
    "checked_at_utc",
    "rank_position",
    "result_window",
    "matched_url",
    "source",
    "degraded",
    "degraded_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "blog_rank_snapshot.v0.1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^brs_[0-9a-f]{20}$"
    },
    "package_id": {
      "type": "string",
      "pattern": "^bcp_[0-9a-f]{20}$"
    },
    "target_keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "published_url": {
      "type": "string",
      "pattern": "^https://blog\\.naver\\.com/.+",
      "maxLength": 500
    },
    "checkpoint": {
      "enum": [
        "D+1",
        "D+7",
        "D+14",
        "D+28"
      ]
    },
    "checked_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rank_position": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "result_window": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "matched_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "degraded": {
      "type": "boolean"
    },
    "degraded_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "degraded": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "rank_position": {
            "type": "null"
          },
          "degraded_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rank_position": {
            "type": "integer"
          }
        }
      },
      "then": {
        "properties": {
          "matched_url": {
            "type": "string"
          }
        }
      }
    }
  ]
}
