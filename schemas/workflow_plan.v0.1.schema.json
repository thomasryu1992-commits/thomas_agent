{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow_plan.v0.1.schema.json",
  "title": "Workflow Plan v0.1 — a validated multi-step plan the assistant submits",
  "description": "What Hermes proposes and the workflow manager executes (docs/HERMES_ORCHESTRATOR_ARCHITECTURE_V0.2.md §4). Closed: a plan cannot name an effect class, an actor or a permission — the capability table in runtime/mvp_runtime/workflow.py owns the effect class, the door's peer owns the principal, and the runtime's Prime owns the role. Steps form a DAG over `depends_on`; `input_refs` names the dependency steps whose results feed a step. A step may ask for Thomas's approval before it runs (`requires_approval`); a plan cannot carry an approval, only ask for one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "steps",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow_plan.v0.1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "request",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "capability": {
            "enum": [
              "analysis",
              "research",
              "translation",
              "content"
            ]
          },
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "uniqueItems": true,
            "maxItems": 10
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "uniqueItems": true,
            "maxItems": 10
          },
          "naver_keywords": {
            "type": "string",
            "maxLength": 200
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "independent_validation": {
                "type": "boolean"
              },
              "revise": {
                "type": "boolean"
              },
              "important": {
                "type": "boolean"
              }
            }
          },
          "requires_approval": {
            "description": "The step runs only after Thomas approves it on the control bot (sequence 2, P07). The manager mints the ask; the plan never carries an approval id or a decision — those keys are refused by this closed schema.",
            "type": "boolean"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_calls"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
