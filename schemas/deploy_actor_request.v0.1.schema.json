{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deploy_actor_request.v0.1.schema.json",
  "title": "Option C deploy runner — the message the gatekeeper forwards to the actor (C2 §0N, N1). The actor re-validates every field itself",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proto",
    "gate_intake_seq",
    "client_id",
    "request_id",
    "verb",
    "args",
    "approval_document_b64",
    "approval_signature"
  ],
  "properties": {
    "proto": {
      "const": 1
    },
    "gate_intake_seq": {
      "type": "integer",
      "minimum": 1
    },
    "client_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}\\Z"
        }
      ]
    },
    "request_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}\\Z"
        }
      ]
    },
    "verb": {
      "enum": [
        "inspect_candidate",
        "prepare_candidate",
        "validate_candidate",
        "promote",
        "rollback"
      ]
    },
    "args": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "git_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}\\Z"
        },
        "candidate_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        },
        "rollback_image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}\\Z"
        }
      }
    },
    "approval_document_b64": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2734
        }
      ]
    },
    "approval_signature": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      ]
    }
  }
}
